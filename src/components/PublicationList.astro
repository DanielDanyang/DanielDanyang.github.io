---
import type { BibEntry } from "../lib/bibtex";

interface Props {
  papers: BibEntry[];
}

const { papers } = Astro.props;
---

<ol
  data-publication-list
  class="publication-list m-0 list-none rounded-xl border border-paper-300/90 bg-white/70 p-0 shadow-paper dark:border-ink-700 dark:bg-ink-900/65"
>
  {papers.map((paper) => (
    <li>
      <article class="group px-4 transition-colors duration-200 hover:bg-accent-50/50 dark:hover:bg-accent-950/20 sm:px-6">
        <div class="min-w-0 space-y-2.5">
          <div class="space-y-1">
            <h3 class="entry-title text-[1.1875rem]">
              {paper.url ? (
                <>
                  <a href={paper.url} target="_blank" rel="noopener noreferrer" class="inline text-inherit no-underline transition-colors hover:text-accent-700 focus-visible:text-accent-700 dark:hover:text-accent-300 dark:focus-visible:text-accent-300">{paper.title}</a>{" "}
                  <a href={paper.url} target="_blank" rel="noopener noreferrer" class="pdf-link" aria-label={`PDF for ${paper.title}, opens in a new tab`}>
                    <span class="i-mdi:file-pdf-box text-sm" aria-hidden="true"></span>
                    <span>PDF</span>
                  </a>
                </>
              ) : paper.title}
            </h3>
            {paper.authors.length > 0 && (
              <p class="entry-supporting text-sm">
                {paper.authors.map((author, index) => (
                  <>
                    {index > 0 && ", "}
                    {author === "Danyang Chen" ? <strong class="own-author">{author}</strong> : author}
                  </>
                ))}
              </p>
            )}
          </div>
          <div class="entry-meta flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
            {paper.venue && <span class="font-semibold text-accent-800 dark:text-accent-200">{paper.venue}</span>}
            {paper.venue && paper.year && <span class="text-ink-400 dark:text-paper-500" aria-hidden="true">/</span>}
            {paper.year && <time datetime={String(paper.year)} class="tabular-nums font-mono text-ink-600 dark:text-paper-300">{paper.year}</time>}
            {paper.category && <span class="scholarly-pill ml-1">{paper.category}</span>}
          </div>
        </div>
      </article>
    </li>
  ))}
</ol>

<style>
  .publication-list { display: grid; gap: 2rem; margin-top: 1.25rem; }
  .pdf-link { display: inline-flex; align-items: center; gap: .25rem; margin-left: .25rem; padding: .2rem .4rem; border: 1px solid var(--glass-control-border); border-radius: .4rem; background: var(--glass-control); font-family: sans-serif; font-size: .75rem; font-weight: 600; line-height: 1.4; vertical-align: middle; white-space: nowrap; color: inherit; text-decoration: none; }
  .pdf-link:hover { text-decoration: underline; }
  .own-author { color: var(--color-ink-900, #202521); font-weight: 700; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  :global(.dark) .own-author { color: #f5f3ed; }
</style>
