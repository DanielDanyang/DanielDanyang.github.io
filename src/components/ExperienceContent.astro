---
import PublicationList from "../components/PublicationList.astro";
import { getCollection } from "astro:content";
import { getAllPapers } from "../lib/papers";
import { aboutDataSchema } from "../lib/about";
import aboutRaw from "../data/about.yml?raw";
import { parse } from "yaml";

const cv = aboutDataSchema.parse(parse(aboutRaw));
const projects = await getCollection("projects", ({ data }) => !data.draft);
const papers = getAllPapers();
const experience = cv.experience ?? [];
const industry = experience.filter((entry) => entry.organization?.startsWith("Tencent") || entry.organization === "Kling AI");
const research = experience.filter((entry) => entry.project === "uccl" || entry.project === "gpuweaver").sort((a, b) => (a.project === "uccl" ? 0 : 1) - (b.project === "uccl" ? 0 : 1)).map((entry) => ({
  ...entry,
  projectRecord: projects.find((project) => project.id === entry.project),
}));
const service = cv.service ?? [];
---

<div id="experience" class="cv-page scroll-mt-24">
    <div class="cv-sections">
      <section id="industry" class="cv-section">
        <h2 class="page-title cv-heading">Industry Experience</h2>
        {industry.map((entry) => (
          <article class="cv-entry">
            <div class="cv-row">
              <h3 class="entry-title text-lg">{entry.organization}</h3>
              <p class="cv-date">{entry.period}</p>
            </div>
            <p class="body-copy mt-1">{entry.role}</p>
            {entry.bullets?.length && <ul class="cv-bullets">{entry.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
          </article>
        ))}
      </section>

      <section id="research" class="cv-section">
        <h2 class="page-title cv-heading">Academic Experience</h2>
        {research.map((entry) => (
          <article id={entry.project === "gpuweaver" ? "publications" : entry.project === "uccl" ? "uccl" : undefined} class:list={["cv-entry scroll-mt-24", entry.project === "gpuweaver" && "cv-publications"]}>
            <div class:list={["cv-row", entry.project === "uccl" && "uccl-heading"]}>
              <h3 class="section-heading">{entry.project === "uccl" ? <>UCCL<span class="uccl-intro font-sans">: an efficient communication library for GPUs, covering collectives, P2P, and EP</span></> : entry.project === "gpuweaver" ? "Publication" : entry.projectRecord?.data.title ?? entry.organization}</h3>
              {entry.project === "uccl" && <>
                <a class="action-link px-0 uccl-github" href="https://github.com/uccl-project/uccl" target="_blank" rel="noopener noreferrer">
                  GitHub
                  <img src="https://img.shields.io/github/stars/uccl-project/uccl?style=social" alt="UCCL GitHub stars" height="20" loading="lazy" />
                </a>
              </>}
            </div>
            {entry.project !== "gpuweaver" && entry.project !== "uccl" && <p class="body-copy mt-1">{entry.role}</p>}
            {entry.project === "gpuweaver" ? <PublicationList papers={papers} /> : entry.projectRecord && <p class="body-copy mt-2 text-sm">{entry.projectRecord.data.summary}</p>}
            {entry.bullets?.length && <ul class="cv-bullets">{entry.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
            {entry.projectRecord && entry.project !== "gpuweaver" && (
              <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
                {entry.projectRecord.data.links.filter((link) => entry.project !== "uccl" || link.label === "Contributions").map((link) => <a class="action-link px-0 text-xs" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span class="i-mdi:open-in-new text-xs" aria-hidden="true"></span></a>)}
                {entry.project === "uccl" && <span class="body-copy text-sm">Advised by <a class="font-semibold text-accent-700 underline decoration-accent-300 underline-offset-4 dark:text-accent-300 dark:decoration-accent-700" href="https://yangzhou1997.github.io/" target="_blank" rel="noopener noreferrer">Yang Zhou</a></span>}
              </div>
            )}
          </article>
        ))}
      </section>

      <section id="teaching" class="cv-section">
        <h2 class="page-title cv-heading">Teaching</h2>
        <p class="body-copy mb-3 text-sm">Teaching Assistant at CUHK-Shenzhen.</p>
        <ul class="m-0 list-none space-y-2 p-0">
          {service.map((entry) => typeof entry === "string" ? <li class="body-copy text-sm">{entry}</li> : (
            <li class="cv-row text-sm">
              <span>{entry.role?.replace(/^Teaching Assistant — /, "")}</span>
              <span class="cv-date">{entry.period}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
</div>

<style>
  .cv-sections { display: grid; gap: var(--homepage-section-gap, 3rem); }
  .cv-section { scroll-margin-top: 8rem; }
  .cv-heading { border-bottom: 1px solid; border-color: var(--cv-border); padding-bottom: .75rem; margin-bottom: 1.25rem; }
  .cv-page { --cv-border: #d9d5c9; }
  :global(.dark) .cv-page { --cv-border: #434844; }
  .cv-entry + .cv-entry { margin-top: 1.75rem; }
  .cv-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .uccl-heading { flex-wrap: wrap; align-items: baseline; justify-content: flex-start; gap: .75rem 1rem; }
  .uccl-intro { font-size: 1rem; font-weight: 400; line-height: 1.75; letter-spacing: normal; }
  .uccl-github { display: inline-flex; align-items: center; gap: .5rem; font-size: .8125rem; }
  .uccl-github img { height: 20px; width: auto; }
  .cv-date { flex-shrink: 0; font-family: monospace; font-size: .8125rem; color: #68706b; }
  :global(.dark) .cv-date { color: #b9c0b9; }
  .cv-bullets { list-style: disc; padding-left: 1.2rem; margin-top: .65rem; font-size: .9375rem; line-height: 1.7; }
  .cv-bullets li + li { margin-top: .25rem; }
  .cv-publications :global([data-publication-list]) { border: 0; border-radius: 0; background: transparent; box-shadow: none; }
  .cv-publications :global([data-publication-list] article) { padding-left: 0; padding-right: 0; }
  @media (max-width: 639px) { .cv-row { flex-direction: column; gap: .35rem; } .uccl-heading { flex-direction: row; gap: .5rem 1rem; } }
</style>
