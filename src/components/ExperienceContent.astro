---
import PublicationList from "../components/PublicationList.astro";
import { getCollection } from "astro:content";
import { getAllPapers } from "../lib/papers";
import { aboutDataSchema } from "../lib/about";
import aboutRaw from "../data/about.yml?raw";
import { parse } from "yaml";

const cv = aboutDataSchema.parse(parse(aboutRaw));
const projects = await getCollection("projects", ({ data }) => !data.draft);
const papers = getAllPapers();
const experience = cv.experience ?? [];
const industry = experience.filter((entry) => entry.organization?.startsWith("Tencent") || entry.organization === "Kling");
const research = experience.filter((entry) => entry.project === "uccl" || entry.project === "gpuweaver").sort((a, b) => (a.project === "uccl" ? 0 : 1) - (b.project === "uccl" ? 0 : 1)).map((entry) => ({
  ...entry,
  projectRecord: projects.find((project) => project.id === entry.project),
}));
const service = cv.service ?? [];
---

<section id="experience" aria-labelledby="experience-heading" class="page-stack cv-page scroll-mt-24">
    <header class="page-header">
      <h2 id="experience-heading" class="page-title">Experience</h2>
    </header>

    <div class="cv-sections">
      <section id="industry" class="cv-section">
        <h2 class="section-heading cv-heading">Industry Experience</h2>
        {industry.map((entry) => (
          <article class="cv-entry">
            <div class="cv-row">
              <h3 class="entry-title text-lg">{entry.organization}</h3>
              <p class="cv-date">{entry.period}</p>
            </div>
            <p class="body-copy mt-1">{entry.role}</p>
            {entry.bullets?.length && <ul class="cv-bullets">{entry.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
          </article>
        ))}
      </section>

      <section id="research" class="cv-section">
        <h2 class="section-heading cv-heading">Academic Experience</h2>
        {research.map((entry) => (
          <article id={entry.project === "gpuweaver" ? "publications" : undefined} class:list={["cv-entry scroll-mt-24", entry.project === "gpuweaver" && "cv-publications"]}>
            <div class="cv-row">
              <h3 class="entry-title text-lg">{entry.project === "uccl" ? "Open-source Projects" : entry.project === "gpuweaver" ? "Publication" : entry.projectRecord?.data.title ?? entry.organization}</h3>
            </div>
            {entry.project !== "gpuweaver" && <p class="body-copy mt-1">{entry.role}</p>}
            {entry.project === "gpuweaver" ? <PublicationList papers={papers} /> : entry.projectRecord && <p class="body-copy mt-2 text-sm">{entry.projectRecord.data.summary}</p>}
            {entry.bullets?.length && <ul class="cv-bullets">{entry.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
            {entry.projectRecord && entry.project !== "gpuweaver" && (
              <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
                {entry.projectRecord.data.links.map((link) => <a class="action-link px-0 text-xs" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span class="i-mdi:open-in-new text-xs" aria-hidden="true"></span></a>)}
              </div>
            )}
          </article>
        ))}
      </section>

      <section id="teaching" class="cv-section">
        <h2 class="section-heading cv-heading">Teaching</h2>
        <p class="body-copy mb-3 text-sm">Teaching Assistant at CUHK-Shenzhen.</p>
        <ul class="m-0 list-none space-y-2 p-0">
          {service.map((entry) => typeof entry === "string" ? <li class="body-copy text-sm">{entry}</li> : (
            <li class="cv-row text-sm">
              <span>{entry.role?.replace(/^Teaching Assistant — /, "")}</span>
              <span class="cv-date">{entry.period}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
</section>

<style>
  .cv-sections { display: grid; gap: 3rem; }
  .cv-section { scroll-margin-top: 8rem; }
  .cv-heading { border-bottom: 1px solid; border-color: var(--cv-border); padding-bottom: .75rem; margin-bottom: 1.25rem; }
  .cv-page { --cv-border: #d9d5c9; }
  :global(.dark) .cv-page { --cv-border: #434844; }
  .cv-entry + .cv-entry { margin-top: 1.75rem; }
  .cv-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .cv-date { flex-shrink: 0; font-family: monospace; font-size: .8125rem; color: #68706b; }
  :global(.dark) .cv-date { color: #b9c0b9; }
  .cv-bullets { list-style: disc; padding-left: 1.2rem; margin-top: .65rem; font-size: .9375rem; line-height: 1.7; }
  .cv-bullets li + li { margin-top: .25rem; }
  .cv-publications :global([data-publication-list]) { border: 0; border-radius: 0; background: transparent; box-shadow: none; }
  .cv-publications :global([data-publication-list] article) { padding-left: 0; padding-right: 0; }
  @media (max-width: 639px) { .cv-row { flex-direction: column; gap: .35rem; } }
</style>
