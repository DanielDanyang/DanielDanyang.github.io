---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Personal" description="A small corner for life beyond research.">
  <div class="page-stack">
    <header class="page-header">
      <p class="eyebrow">Personal · 工作之外</p>
      <h1 class="page-title">Beyond research</h1>
      <p class="page-description">A small corner for life beyond research.</p>
    </header>
    <section class="surface-card max-w-3xl space-y-5 p-6 sm:p-8">
      <span class="i-ph-coffee text-3xl text-accent-600 dark:text-accent-300" aria-hidden="true"></span>
      <h2 class="section-heading">Hello, I’m Danyang.</h2>
      <p class="body-copy" lang="zh-CN">这里留给工作之外的生活，慢慢补充。</p>
      <p class="body-copy">This space will grow with personal notes, moments, and things I enjoy.</p>
      <a href="/" class="action-link px-0">Back to my academic homepage <span class="i-ph-arrow-right" aria-hidden="true"></span></a>
    </section>
  </div>
</Layout>
