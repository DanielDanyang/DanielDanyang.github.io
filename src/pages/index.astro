---
import Layout from "../layouts/Layout.astro";
import ExperienceContent from "../components/ExperienceContent.astro";
import siteConfig from "../side.config";
import { Image } from "astro:assets";

const showHero = siteConfig.homeBlocks.hero.enabled;

const rawProfileImage = siteConfig.hero.profileImage.trim();
const profileImageUrl = /^https?:/i.test(rawProfileImage)
  ? rawProfileImage
  : rawProfileImage.startsWith("/")
    ? rawProfileImage
    : new URL(
        rawProfileImage.startsWith(".")
          ? rawProfileImage
          : `../${rawProfileImage}`,
        import.meta.url,
      ).href;

const about = {
  name: siteConfig.author,
  bio: siteConfig.hero.subheadline,
  avatar: profileImageUrl,
  socialLinks: siteConfig.socialLinks,
};

// Get affiliations and research interests from config
const affiliations = siteConfig.affiliations || [];
const researchInterests = siteConfig.researchInterests || [];
const statusBadge = siteConfig.hero.statusBadge;
const profileAlt = siteConfig.hero.profileAlt || about.name;
---

<Layout
  title="Home"
  description={siteConfig.hero.subheadline}
  schemaType="ProfilePage"
>
  <div class="space-y-12 pb-2 sm:space-y-16 sm:pb-4">
    {showHero && (
      <section class="relative border-b border-paper-300/90 pb-9 pt-3 dark:border-ink-700 sm:pb-12 sm:pt-6">
      <div class="relative grid gap-6 lg:grid-cols-[minmax(0,1fr)_13rem] lg:items-start lg:gap-x-14">
        <div class="min-w-0 lg:col-start-1 lg:row-start-1">
          <h1 class="max-w-4xl font-heading text-[clamp(1.75rem,5vw,4.5rem)] font-semibold leading-[1] tracking-[-0.035em] text-ink-950 dark:text-paper-50">
            {about.name}{" "}<span lang="zh-CN" class="inline-block text-inherit font-semibold tracking-normal">(陈丹阳)</span>
          </h1>



          {affiliations.length > 0 && (
            <div class="mt-4">
              <div class="space-y-1">
                {affiliations.map((aff) => (
                  <p class="text-base leading-7 text-ink-600 dark:text-paper-300">
                    {aff.role}
                    {aff.department && <span>, {aff.department}</span>}
                    {aff.url ? (
                      <a
                        href={aff.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="ml-1 font-semibold text-accent-700 underline decoration-accent-300 underline-offset-4 transition-colors hover:text-accent-900 dark:text-accent-300 dark:decoration-accent-700 dark:hover:text-accent-100"
                      >
                        {aff.institution}
                      </a>
                    ) : (
                      <span> {aff.institution}</span>
                    )}
                  </p>
                ))}
              </div>
            </div>
          )}
        </div>

        <aside class="w-32 sm:w-40 lg:w-full lg:col-start-2 lg:row-span-2 lg:row-start-1" aria-label="Profile">
          <div class="relative w-full shrink-0 overflow-hidden rounded-xl border border-paper-300/90 bg-white/70 p-1.5 shadow-paper dark:border-ink-700 dark:bg-ink-900/70 lg:p-2">
            <Image
              src={about.avatar}
              alt={profileAlt}
              width={siteConfig.hero.profileImageWidth || 160}
              height={siteConfig.hero.profileImageHeight || 160}
              layout="constrained"
              fit="cover"
              priority
              class="h-auto w-full rounded-lg object-cover"
            />
          </div>
          <div class="mt-4 flex flex-col items-start gap-1" aria-label="Contact and social links">
            {about.socialLinks.map((link) => {
              const opensNewTab = /^https?:/i.test(link.href);
              return (
                <a
                  href={link.href}
                  target={opensNewTab ? "_blank" : undefined}
                  rel={opensNewTab ? "noopener noreferrer" : undefined}
                  class="action-link px-0"
                >
                  <span class={`${link.icon} text-base`} aria-hidden="true" />
                  <span>{link.label}</span>
                </a>
              );
            })}
          </div>
          {statusBadge && (
            <div class="inline-flex items-center gap-1.5 rounded-md border border-accent-300/40 bg-accent-50/70 px-2.5 py-1 text-xs font-semibold text-accent-800 dark:border-accent-700/50 dark:bg-accent-950/40 dark:text-accent-200 lg:mt-4">
              <span class="h-1.5 w-1.5 rounded-full bg-accent-500 animate-pulse" aria-hidden="true" />
              <span>{statusBadge}</span>
            </div>
          )}
        </aside>

        <div class="min-w-0 lg:col-start-1 lg:row-start-2">
          <h2 id="about-heading" class="page-title">About me</h2>
          <p class="mt-5 max-w-[65ch] text-[1.0625rem] leading-7 text-ink-700 dark:text-paper-300">
            {about.bio}
          </p>
          <p class="mt-4 max-w-[65ch] text-[1.0625rem] leading-7 text-ink-700 dark:text-paper-300">
            During my undergraduate studies, I have been very fortunate to be advised by{" "}
            <a href="https://yangzhou1997.github.io/" target="_blank" rel="noopener noreferrer" class="font-semibold text-accent-700 underline decoration-accent-300 underline-offset-4 dark:text-accent-300 dark:decoration-accent-700">Yang Zhou</a>{" "}and{" "}
            <a href="https://yunmingxiao.github.io/" target="_blank" rel="noopener noreferrer" class="font-semibold text-accent-700 underline decoration-accent-300 underline-offset-4 dark:text-accent-300 dark:decoration-accent-700">Yunming Xiao</a>.
          </p>

          {researchInterests.length > 0 && (
            <div class="mt-6 border-t border-paper-300/80 pt-4 dark:border-ink-700/80" aria-label="Research interests">
              <span class="sr-only">Research interests:</span>
              <ul class="flex list-none flex-wrap gap-2 p-0 m-0">
                {researchInterests.map((interest) => (
                  <li class="meta-chip">
                    <span class="h-1 w-1 rounded-full bg-accent-500" aria-hidden="true"></span>
                    <span>{interest}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
      </section>
    )}

    <ExperienceContent />
  </div>
</Layout>
